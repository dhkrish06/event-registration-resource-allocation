# Copy this file to .env.local and fill in your values. NEVER commit .env.local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_mgmt
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=event_mgmt
JWT_SECRET=change-this-to-a-long-random-string
# Password for the seeded admin account (admin@event.local)
ADMIN_PASSWORD=Admin@123
# Password for seeded demo organizer/student accounts
DEMO_PASSWORD=Password@123
